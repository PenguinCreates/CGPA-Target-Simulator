{
  "expo": {
    "name": "Studyline CGPA Tracker",
    "slug": "studylinecgpatracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "studylinecgpatracker",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#edf4fa",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.studylinecgpatracker.app"
    },
    "android": {
      "package": "com.studylinecgpatracker.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}